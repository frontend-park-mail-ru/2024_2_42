<div class="board-edit-window__content-container">
    <div class="close-windows__block-container">
        <img src="./assets/icons/close.svg" alt="Close">
    </div>

    <div class="board-edit-window__main-container">
        {{#if state.CreateMode}}
            <p class="board-edit-window__title">Создайте доску</p>
        {{else}}
            <p class="board-edit-window__title">Отредактируйте доску</p>
        {{/if}}

        <div class="board-edit-window__data-container">
            <div class="board-edit-window__cover-container">

            </div>

            <div class="board-edit-window__inputs-container">

            </div>
        </div>
    </div>
</div>
