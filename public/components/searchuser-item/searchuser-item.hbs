<div class="search-user__user">
    <div class="search-user__avatar">
        <img src="{{AvatarUrl}}">
    </div>
    <div class="search-user__info">
        <div class="search-user__name">
            {{UserName}}
        </div>
        <div class="search-user__nick">
            @{{NickName}}
        </div>
    </div>
    <div class="search-user__add-chat">
        <div class="add-chat-btn" data-companion-id="{{UserID}}">
            +
        </div>
    </div>
</div>