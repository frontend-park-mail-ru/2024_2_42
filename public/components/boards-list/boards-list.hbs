<div class="savebox__boards-list">
    {{#if boards}}
        {{#each boards}}
            <div class="savebox__board-selection savebox__board-selection-{{this.BoardName}}">
                <input class="savebox__board-checkbox" type="radio" id="checkbox-{{this.BoardName}}" value="{{this.BoardName}}">
                <div class="savebox__board-cover-container">
                    <img class="savebox__board-cover" src="{{this.BoardCoverUrl}}" alt="cover">
                </div>
                <label class="savebox__board-label" for="checkbox-{{this.BoardName}}">{{{this.BoardName}}}</label>
                {{#if this.Private}}
                    <img class="savebox__board-private-icon" src="./assets/icons/private.svg" alt="private">
                {{/if}}
            </div>
        {{/each}}
    {{else}}
        <p>Здесь будут отображены доски</p>
    {{/if}}
</div>
