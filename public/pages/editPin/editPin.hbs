
<div class="editpin-container">
    <div class="editpin__image">
        <div class="editpin__image-container">
            {{#if noImage}}
                <div class="noimage__icon">
                    <img src="./assets/icons/check-photo.svg" alt="checkphoto">
                </div>
            <div class="noimage__text">
                выберите файл или перетащите его сюда
            </div>
            {{else}}
                <img src="/assets/imgs/michael.jpg" alt="Image">
            {{/if}}
        </div>
        <input id="editpin__image-input" type="file" name="image" accept="image/*">
    </div>
    <div class="editpin__data">
        <div class="editpin__title">
            {{{TitleInput}}}
        </div>
        <div class="editpin__description">
            {{{DescriptionInput}}}
        </div>
        <div class="editpin__pinboard">
            <div class="editpin__pinboard-text">Выберите доску</div>
            {{!-- <div class="editpin__pinboard-icon">

            </div> --}}
        </div>
        <div class="editpin__submit">
            {{{PublishButton}}}
        </div>
    </div>
</div>








